// StaffOS data model — source of truth (CLAUDE.md §2, §9). ERD: docs/erd.md
//
// Conventions
// - UUID v7 primary keys (time-ordered, so B-tree inserts stay local), generated by Prisma.
// - Tables/columns are snake_case in Postgres (@@map/@map) so reporting SQL and the
//   "ask your data" feature never need quoted identifiers; code uses camelCase.
// - Business tables carry created_at / updated_at / created_by_id; deleted_at where history matters.
// - Money: integer minor units (`…Fils`) + `currency`. Durations: integer minutes. No floats.
// - `version` on records with state transitions → optimistic locking (409 STALE_VERSION).
// - Constraints Prisma can't express (CHECKs, append-only triggers, overlap exclusion) live in
//   hand-written migrations; see prisma/migrations/*_integrity.
// Database URL is configured in apps/api/prisma.config.ts (Prisma 7).

generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  // The API compiles to CommonJS (NestJS template), so generate CJS-compatible code.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

