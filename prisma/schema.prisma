// ─────────────────────────────────────────────────────────────────────────────
// Identity and access
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                String     @id @default(uuid(7)) @db.Uuid
  /// Stored lower-cased by the service; unique across all users.
  email             String     @unique
  /// argon2id hash; null until an invited user sets a password.
  passwordHash      String?    @map("password_hash")
  firstName         String     @map("first_name")
  lastName          String     @map("last_name")
  status            UserStatus @default(INVITED)
  /// Set only for CLIENT_USER accounts: the one client company they belong to.
  clientId          String?    @map("client_id") @db.Uuid
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById       String?    @map("created_by_id") @db.Uuid

  client    Client? @relation("ClientUsers", fields: [clientId], references: [id])
  createdBy User?   @relation("UserCreatedBy", fields: [createdById], references: [id])

  // Back-relations (one per foreign key that points at users).
  usersCreated               User[]                    @relation("UserCreatedBy")
  roles                      UserRole[]
  refreshTokens              RefreshToken[]
  authTokens                 AuthToken[]
  clientsManaged             Client[]                  @relation("ClientAccountManager")
  clientsCreated             Client[]                  @relation("ClientCreatedBy")
  contactPortal              ClientContact?            @relation("ContactPortalUser")
  contactsCreated            ClientContact[]           @relation("ContactCreatedBy")
  activitiesCreated          Activity[]                @relation("ActivityCreatedBy")
  manpowerRequestsCreated    ManpowerRequest[]         @relation("ManpowerRequestCreatedBy")
  manpowerRequestsDecided    ManpowerRequest[]         @relation("ManpowerRequestDecidedBy")
  jobsCreated                Job[]                     @relation("JobCreatedBy")
  jobsAsHiringManager        Job[]                     @relation("JobHiringManager")
  jobAssignments             JobRecruiter[]
  candidatesCreated          Candidate[]               @relation("CandidateCreatedBy")
  applicationsCreated        Application[]             @relation("ApplicationCreatedBy")
  stageChanges               ApplicationStageHistory[]
  interviewsCreated          Interview[]               @relation("InterviewCreatedBy")
  interviewAssignments       InterviewInterviewer[]
  interviewFeedback          InterviewFeedback[]
  offersCreated              Offer[]                   @relation("OfferCreatedBy")
  offersApproved             Offer[]                   @relation("OfferApprovedBy")
  employee                   Employee?                 @relation("EmployeeUser")
  employeesCreated           Employee[]                @relation("EmployeeCreatedBy")
  documentsCreated           Document[]                @relation("DocumentCreatedBy")
  onboardingTemplatesCreated OnboardingTemplate[]      @relation("OnboardingTemplateCreatedBy")
  onboardingTasksAssigned    OnboardingTask[]          @relation("OnboardingTaskAssignee")
  onboardingTasksCompleted   OnboardingTask[]          @relation("OnboardingTaskCompletedBy")
  projectsCreated            Project[]                 @relation("ProjectCreatedBy")
  deploymentsCreated         Deployment[]              @relation("DeploymentCreatedBy")
  timesheetsCreated          Timesheet[]               @relation("TimesheetCreatedBy")
  timesheetsDecided          Timesheet[]               @relation("TimesheetDecidedBy")
  invoicesCreated            Invoice[]                 @relation("InvoiceCreatedBy")
  workflowsCreated           WorkflowDefinition[]      @relation("WorkflowCreatedBy")
  approvalRequestsCreated    ApprovalRequest[]         @relation("ApprovalRequestCreatedBy")
  approvalDecisions          ApprovalDecision[]
  automationRulesCreated     AutomationRule[]          @relation("AutomationRuleCreatedBy")
  tasksAssigned              Task[]                    @relation("TaskAssignee")
  tasksCreated               Task[]                    @relation("TaskCreatedBy")
  aiRequests                 AiRequest[]
  notifications              Notification[]
  auditLogs                  AuditLog[]
  webhooksCreated            Webhook[]                 @relation("WebhookCreatedBy")
  settingsUpdated            Setting[]
  dataRequestsResolved       DataSubjectRequest[]

  @@index([clientId])
  @@index([createdById])
  @@index([status])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        RoleCode @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// `resource:action`, e.g. `clients:read` (docs/security.md §3).
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Rotating refresh tokens. Only the SHA-256 hash is stored; `familyId` groups a rotation chain
/// so reuse of a revoked token can revoke the whole family (docs/security.md §2).
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @unique @map("replaced_by_id") @db.Uuid
  createdByIp  String?   @map("created_by_ip")
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("RefreshTokenRotation", fields: [replacedById], references: [id])
  replaces   RefreshToken? @relation("RefreshTokenRotation")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Single-use tokens for password reset and invitations (hashed at rest).
model AuthToken {
  id        String        @id @default(uuid(7)) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// CRM
// ─────────────────────────────────────────────────────────────────────────────

model Client {
  id               String       @id @default(uuid(7)) @db.Uuid
  name             String
  industry         Industry
  /// UAE Tax Registration Number (15 digits).
  trn              String?      @unique
  /// VAT in basis points: 500 = 5%. Per client because free-zone clients may be zero-rated.
  vatRateBps       Int          @default(500) @map("vat_rate_bps")
  addressLine1     String?      @map("address_line1")
  city             String
  emirate          Emirate
  country          String       @default("AE") @db.Char(2)
  paymentTermsDays Int          @default(30) @map("payment_terms_days")
  status           ClientStatus @default(ACTIVE)
  accountManagerId String       @map("account_manager_id") @db.Uuid
  /// Zoho CRM record id for two-way sync (integrations module).
  zohoId           String?      @unique @map("zoho_id")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById      String?      @map("created_by_id") @db.Uuid
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz(3)

  accountManager User  @relation("ClientAccountManager", fields: [accountManagerId], references: [id])
  createdBy      User? @relation("ClientCreatedBy", fields: [createdById], references: [id])

  users            User[]            @relation("ClientUsers")
  contacts         ClientContact[]
  activities       Activity[]
  manpowerRequests ManpowerRequest[]
  jobs             Job[]
  projects         Project[]
  deployments      Deployment[]
  timesheets       Timesheet[]
  invoices         Invoice[]

  @@index([accountManagerId])
  @@index([createdById])
  @@index([status])
  @@index([createdAt])
  @@map("clients")
}

model ClientContact {
  id           String    @id @default(uuid(7)) @db.Uuid
  clientId     String    @map("client_id") @db.Uuid
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  email        String?
  phone        String?
  jobTitle     String?   @map("job_title")
  isPrimary    Boolean   @default(false) @map("is_primary")
  /// Set when the contact is invited to the client portal.
  portalUserId String?   @unique @map("portal_user_id") @db.Uuid
  zohoId       String?   @unique @map("zoho_id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById  String?   @map("created_by_id") @db.Uuid
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  client     Client @relation(fields: [clientId], references: [id])
  portalUser User?  @relation("ContactPortalUser", fields: [portalUserId], references: [id])
  createdBy  User?  @relation("ContactCreatedBy", fields: [createdById], references: [id])

  activities Activity[]

  @@index([clientId])
  @@index([createdById])
  @@map("client_contacts")
}

model Activity {
  id          String       @id @default(uuid(7)) @db.Uuid
  clientId    String       @map("client_id") @db.Uuid
  contactId   String?      @map("contact_id") @db.Uuid
  type        ActivityType
  subject     String
  body        String?
  occurredAt  DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?      @map("created_by_id") @db.Uuid

  client    Client         @relation(fields: [clientId], references: [id])
  contact   ClientContact? @relation(fields: [contactId], references: [id])
  createdBy User?          @relation("ActivityCreatedBy", fields: [createdById], references: [id])

  @@index([clientId, occurredAt(sort: Desc)])
  @@index([contactId])
  @@index([createdById])
  @@map("activities")
}

model ManpowerRequest {
  id              String                @id @default(uuid(7)) @db.Uuid
  clientId        String                @map("client_id") @db.Uuid
  projectId       String?               @map("project_id") @db.Uuid
  roleTitle       String                @map("role_title")
  category        JobCategory
  headcount       Int
  location        String
  emirate         Emirate
  startDate       DateTime              @map("start_date") @db.Date
  durationMonths  Int?                  @map("duration_months")
  billRateMinFils Int?                  @map("bill_rate_min_fils")
  billRateMaxFils Int?                  @map("bill_rate_max_fils")
  currency        String                @default("AED") @db.Char(3)
  requirements    String?
  status          ManpowerRequestStatus @default(DRAFT)
  version         Int                   @default(1)
  submittedAt     DateTime?             @map("submitted_at") @db.Timestamptz(3)
  decidedAt       DateTime?             @map("decided_at") @db.Timestamptz(3)
  decidedById     String?               @map("decided_by_id") @db.Uuid
  decisionComment String?               @map("decision_comment")
  cancelReason    String?               @map("cancel_reason")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById     String?               @map("created_by_id") @db.Uuid

  client    Client   @relation(fields: [clientId], references: [id])
  project   Project? @relation(fields: [projectId], references: [id])
  decidedBy User?    @relation("ManpowerRequestDecidedBy", fields: [decidedById], references: [id])
  createdBy User?    @relation("ManpowerRequestCreatedBy", fields: [createdById], references: [id])

  jobs             Job[]
  approvalRequests ApprovalRequest[]

  @@index([clientId, status])
  @@index([status])
  @@index([createdAt])
  @@index([projectId])
  @@index([decidedById])
  @@index([createdById])
  @@map("manpower_requests")
}

// ─────────────────────────────────────────────────────────────────────────────
// Recruitment (ATS)
// ─────────────────────────────────────────────────────────────────────────────

model Job {
  id                String      @id @default(uuid(7)) @db.Uuid
  manpowerRequestId String      @map("manpower_request_id") @db.Uuid
  /// Copied from the request so scoping queries filter without a join.
  clientId          String      @map("client_id") @db.Uuid
  title             String
  /// Public URL key for the careers portal.
  slug              String      @unique
  description       String?
  category          JobCategory
  location          String
  emirate           Emirate
  headcount         Int
  salaryMinFils     Int?        @map("salary_min_fils")
  salaryMaxFils     Int?        @map("salary_max_fils")
  currency          String      @default("AED") @db.Char(3)
  showClientName    Boolean     @default(false) @map("show_client_name")
  status            JobStatus   @default(DRAFT)
  hiringManagerId   String      @map("hiring_manager_id") @db.Uuid
  publishedAt       DateTime?   @map("published_at") @db.Timestamptz(3)
  closedAt          DateTime?   @map("closed_at") @db.Timestamptz(3)
  version           Int         @default(1)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById       String?     @map("created_by_id") @db.Uuid
  deletedAt         DateTime?   @map("deleted_at") @db.Timestamptz(3)

  manpowerRequest ManpowerRequest @relation(fields: [manpowerRequestId], references: [id])
  client          Client          @relation(fields: [clientId], references: [id])
  hiringManager   User            @relation("JobHiringManager", fields: [hiringManagerId], references: [id])
  createdBy       User?           @relation("JobCreatedBy", fields: [createdById], references: [id])

  recruiters   JobRecruiter[]
  skills       JobSkill[]
  applications Application[]

  @@index([manpowerRequestId])
  @@index([clientId, status])
  @@index([status, publishedAt(sort: Desc)])
  @@index([hiringManagerId])
  @@index([createdById])
  @@index([createdAt])
  @@map("jobs")
}

/// Recruiters assigned to a job — the basis of RECRUITER data scoping.
model JobRecruiter {
  jobId     String   @map("job_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([jobId, userId])
  @@index([userId])
  @@map("job_recruiters")
}

model JobSkill {
  id       String      @id @default(uuid(7)) @db.Uuid
  jobId    String      @map("job_id") @db.Uuid
  name     String
  weight   SkillWeight
  minYears Int?        @map("min_years")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, name])
  @@map("job_skills")
}

/// No date of birth, gender, marital status or photo is stored (data minimisation, and those
/// fields must never reach a matching prompt — docs/security.md §7).
model Candidate {
  id                    String          @id @default(uuid(7)) @db.Uuid
  firstName             String          @map("first_name")
  lastName              String          @map("last_name")
  /// Not unique: duplicates are detected in the service and HR can override (US-CAND-02).
  email                 String
  phone                 String?
  location              String?
  currentTitle          String?         @map("current_title")
  totalExperienceMonths Int?            @map("total_experience_months")
  summary               String?
  /// Optional, only if the candidate/recruiter enters it; excluded from AI matching.
  nationality           String?
  /// [{ degree, institution?, year? }] — parsed from CV, confirmed by a recruiter.
  education             Json?
  certifications        String[]        @default([])
  languages             String[]        @default([])
  source                CandidateSource
  consentAt             DateTime?       @map("consent_at") @db.Timestamptz(3)
  /// Set by the retention job; personal fields are blanked, history kept for reporting.
  anonymisedAt          DateTime?       @map("anonymised_at") @db.Timestamptz(3)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById           String?         @map("created_by_id") @db.Uuid
  deletedAt             DateTime?       @map("deleted_at") @db.Timestamptz(3)

  createdBy User? @relation("CandidateCreatedBy", fields: [createdById], references: [id])

  skills       CandidateSkill[]
  applications Application[]
  documents    Document[]
  employee     Employee?
  dataRequests DataSubjectRequest[]

  @@index([email])
  @@index([phone])
  @@index([createdById])
  @@index([createdAt])
  @@map("candidates")
}

model CandidateSkill {
  id          String @id @default(uuid(7)) @db.Uuid
  candidateId String @map("candidate_id") @db.Uuid
  name        String
  years       Int?

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, name])
  @@map("candidate_skills")
}

model Application {
  id                String           @id @default(uuid(7)) @db.Uuid
  candidateId       String           @map("candidate_id") @db.Uuid
  jobId             String           @map("job_id") @db.Uuid
  stage             ApplicationStage @default(APPLIED)
  version           Int              @default(1)
  rejectReason      String?          @map("reject_reason")
  /// Hash of the candidate's tracking-link token (careers portal); never the token itself.
  trackingTokenHash String?          @unique @map("tracking_token_hash")
  appliedAt         DateTime         @default(now()) @map("applied_at") @db.Timestamptz(3)
  stageChangedAt    DateTime         @default(now()) @map("stage_changed_at") @db.Timestamptz(3)
  hiredAt           DateTime?        @map("hired_at") @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById       String?          @map("created_by_id") @db.Uuid

  candidate Candidate @relation(fields: [candidateId], references: [id])
  job       Job       @relation(fields: [jobId], references: [id])
  createdBy User?     @relation("ApplicationCreatedBy", fields: [createdById], references: [id])

  stageHistory ApplicationStageHistory[]
  interviews   Interview[]
  offers       Offer[]
  matchResults MatchResult[]
  employee     Employee?

  @@unique([candidateId, jobId])
  @@index([jobId, stage])
  @@index([stage])
  @@index([createdById])
  @@index([createdAt])
  @@map("applications")
}

/// Append-only (enforced by a trigger): the source of time-to-hire and funnel reports.
model ApplicationStageHistory {
  id            String            @id @default(uuid(7)) @db.Uuid
  applicationId String            @map("application_id") @db.Uuid
  /// Null for the initial APPLIED entry.
  fromStage     ApplicationStage? @map("from_stage")
  toStage       ApplicationStage  @map("to_stage")
  reason        String?
  /// Null when the change came from the public careers portal or the system.
  changedById   String?           @map("changed_by_id") @db.Uuid
  changedAt     DateTime          @default(now()) @map("changed_at") @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id])
  changedBy   User?       @relation(fields: [changedById], references: [id])

  @@index([applicationId, changedAt])
  @@index([toStage, changedAt])
  @@index([changedById])
  @@map("application_stage_history")
}

model Interview {
  id            String          @id @default(uuid(7)) @db.Uuid
  applicationId String          @map("application_id") @db.Uuid
  scheduledAt   DateTime        @map("scheduled_at") @db.Timestamptz(3)
  durationMin   Int             @map("duration_min")
  mode          InterviewMode
  location      String?
  meetingUrl    String?         @map("meeting_url")
  status        InterviewStatus @default(SCHEDULED)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById   String?         @map("created_by_id") @db.Uuid

  application Application @relation(fields: [applicationId], references: [id])
  createdBy   User?       @relation("InterviewCreatedBy", fields: [createdById], references: [id])

  interviewers InterviewInterviewer[]
  feedback     InterviewFeedback[]

  @@index([applicationId])
  @@index([scheduledAt])
  @@index([createdById])
  @@map("interviews")
}

model InterviewInterviewer {
  interviewId String @map("interview_id") @db.Uuid
  userId      String @map("user_id") @db.Uuid

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@id([interviewId, userId])
  @@index([userId])
  @@map("interview_interviewers")
}

model InterviewFeedback {
  id             String         @id @default(uuid(7)) @db.Uuid
  interviewId    String         @map("interview_id") @db.Uuid
  interviewerId  String         @map("interviewer_id") @db.Uuid
  /// [{ criterion, score: 1-5 }]
  scores         Json
  recommendation Recommendation
  notes          String?
  submittedAt    DateTime       @default(now()) @map("submitted_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  interview   Interview @relation(fields: [interviewId], references: [id])
  interviewer User      @relation(fields: [interviewerId], references: [id])

  @@unique([interviewId, interviewerId])
  @@index([interviewerId])
  @@map("interview_feedback")
}

model Offer {
  id             String       @id @default(uuid(7)) @db.Uuid
  applicationId  String       @map("application_id") @db.Uuid
  salaryFils     Int          @map("salary_fils")
  currency       String       @default("AED") @db.Char(3)
  startDate      DateTime     @map("start_date") @db.Date
  contractType   ContractType @map("contract_type")
  contractMonths Int?         @map("contract_months")
  notes          String?
  status         OfferStatus  @default(PENDING_APPROVAL)
  version        Int          @default(1)
  approvedById   String?      @map("approved_by_id") @db.Uuid
  approvedAt     DateTime?    @map("approved_at") @db.Timestamptz(3)
  sentAt         DateTime?    @map("sent_at") @db.Timestamptz(3)
  respondedAt    DateTime?    @map("responded_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById    String?      @map("created_by_id") @db.Uuid

  application Application @relation(fields: [applicationId], references: [id])
  approvedBy  User?       @relation("OfferApprovedBy", fields: [approvedById], references: [id])
  createdBy   User?       @relation("OfferCreatedBy", fields: [createdById], references: [id])

  approvalRequests ApprovalRequest[]

  @@index([applicationId, status])
  @@index([status])
  @@index([approvedById])
  @@index([createdById])
  @@map("offers")
}

// ─────────────────────────────────────────────────────────────────────────────
// HR core
// ─────────────────────────────────────────────────────────────────────────────

model Department {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  positions Position[]
  employees Employee[]

  @@map("departments")
}

model Position {
  id           String   @id @default(uuid(7)) @db.Uuid
  title        String   @unique
  departmentId String?  @map("department_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  department Department? @relation(fields: [departmentId], references: [id])

  employees Employee[]

  @@index([departmentId])
  @@map("positions")
}

/// Created by the hire transition (or the seed). Linked to the candidate and application it came from.
model Employee {
  id             String         @id @default(uuid(7)) @db.Uuid
  /// Human-readable, e.g. EMP-000123.
  employeeNumber String         @unique @map("employee_number")
  userId         String?        @unique @map("user_id") @db.Uuid
  candidateId    String?        @unique @map("candidate_id") @db.Uuid
  applicationId  String?        @unique @map("application_id") @db.Uuid
  firstName      String         @map("first_name")
  lastName       String         @map("last_name")
  email          String
  phone          String?
  departmentId   String?        @map("department_id") @db.Uuid
  positionId     String?        @map("position_id") @db.Uuid
  status         EmployeeStatus @default(ONBOARDING)
  hireDate       DateTime       @map("hire_date") @db.Date
  salaryFils     Int?           @map("salary_fils")
  currency       String         @default("AED") @db.Char(3)
  version        Int            @default(1)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById    String?        @map("created_by_id") @db.Uuid
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(3)

  user        User?        @relation("EmployeeUser", fields: [userId], references: [id])
  candidate   Candidate?   @relation(fields: [candidateId], references: [id])
  application Application? @relation(fields: [applicationId], references: [id])
  department  Department?  @relation(fields: [departmentId], references: [id])
  position    Position?    @relation(fields: [positionId], references: [id])
  createdBy   User?        @relation("EmployeeCreatedBy", fields: [createdById], references: [id])

  documents      Document[]
  onboardingPlan OnboardingPlan?
  deployments    Deployment[]
  timesheets     Timesheet[]

  @@index([departmentId])
  @@index([positionId])
  @@index([status])
  @@index([createdById])
  @@index([createdAt])
  @@map("employees")
}

/// Owned by exactly one of candidate/employee (CHECK constraint in the integrity migration):
/// two real foreign keys instead of a polymorphic owner, so the database enforces integrity.
model Document {
  id          String       @id @default(uuid(7)) @db.Uuid
  candidateId String?      @map("candidate_id") @db.Uuid
  employeeId  String?      @map("employee_id") @db.Uuid
  type        DocumentType
  /// Sanitised original file name, metadata only.
  fileName    String       @map("file_name")
  /// Opaque key in the StorageProvider: {ownerType}/{ownerId}/{uuid}.{ext}
  storageKey  String       @unique @map("storage_key")
  mimeType    String       @map("mime_type")
  sizeBytes   Int          @map("size_bytes")
  /// Document number (e.g. passport no.). Masked in lists; never sent to an LLM.
  number      String?
  issueDate   DateTime?    @map("issue_date") @db.Date
  expiryDate  DateTime?    @map("expiry_date") @db.Date
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?      @map("created_by_id") @db.Uuid
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz(3)

  candidate Candidate? @relation(fields: [candidateId], references: [id])
  employee  Employee?  @relation(fields: [employeeId], references: [id])
  createdBy User?      @relation("DocumentCreatedBy", fields: [createdById], references: [id])

  expiryAlerts    DocumentExpiryAlert[]
  onboardingTasks OnboardingTask[]

  @@index([candidateId])
  @@index([employeeId])
  @@index([type, expiryDate])
  @@index([createdById])
  @@map("documents")
}

/// One row per document per alert threshold, so the nightly job never alerts twice (US-DOCS-02).
model DocumentExpiryAlert {
  id            String   @id @default(uuid(7)) @db.Uuid
  documentId    String   @map("document_id") @db.Uuid
  thresholdDays Int      @map("threshold_days")
  sentAt        DateTime @default(now()) @map("sent_at") @db.Timestamptz(3)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, thresholdDays])
  @@map("document_expiry_alerts")
}

// ─────────────────────────────────────────────────────────────────────────────
// Onboarding
// ─────────────────────────────────────────────────────────────────────────────

model OnboardingTemplate {
  id          String       @id @default(uuid(7)) @db.Uuid
  name        String
  /// One template per category; null = default template used when no category matches.
  category    JobCategory? @unique
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?      @map("created_by_id") @db.Uuid

  createdBy User? @relation("OnboardingTemplateCreatedBy", fields: [createdById], references: [id])

  tasks OnboardingTemplateTask[]
  plans OnboardingPlan[]

  @@index([createdById])
  @@map("onboarding_templates")
}

model OnboardingTemplateTask {
  id            String             @id @default(uuid(7)) @db.Uuid
  templateId    String             @map("template_id") @db.Uuid
  title         String
  description   String?
  type          OnboardingTaskType
  assigneeRole  RoleCode           @map("assignee_role")
  /// Due date = employee start date + offset.
  dueOffsetDays Int                @map("due_offset_days")
  required      Boolean            @default(true)
  sortOrder     Int                @default(0) @map("sort_order")

  template OnboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("onboarding_template_tasks")
}

/// Tasks are copied from the template at hire time, so later template edits never change
/// existing plans (US-ONB-01).
model OnboardingPlan {
  id          String               @id @default(uuid(7)) @db.Uuid
  employeeId  String               @unique @map("employee_id") @db.Uuid
  templateId  String?              @map("template_id") @db.Uuid
  status      OnboardingPlanStatus @default(IN_PROGRESS)
  startDate   DateTime             @map("start_date") @db.Date
  completedAt DateTime?            @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee Employee            @relation(fields: [employeeId], references: [id])
  template OnboardingTemplate? @relation(fields: [templateId], references: [id])

  tasks OnboardingTask[]

  @@index([templateId])
  @@index([status])
  @@map("onboarding_plans")
}

model OnboardingTask {
  id            String               @id @default(uuid(7)) @db.Uuid
  planId        String               @map("plan_id") @db.Uuid
  title         String
  description   String?
  type          OnboardingTaskType
  assigneeRole  RoleCode             @map("assignee_role")
  assigneeId    String?              @map("assignee_id") @db.Uuid
  dueDate       DateTime             @map("due_date") @db.Date
  required      Boolean              @default(true)
  status        OnboardingTaskStatus @default(PENDING)
  completedAt   DateTime?            @map("completed_at") @db.Timestamptz(3)
  completedById String?              @map("completed_by_id") @db.Uuid
  note          String?
  documentId    String?              @map("document_id") @db.Uuid
  sortOrder     Int                  @default(0) @map("sort_order")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan        OnboardingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  assignee    User?          @relation("OnboardingTaskAssignee", fields: [assigneeId], references: [id])
  completedBy User?          @relation("OnboardingTaskCompletedBy", fields: [completedById], references: [id])
  document    Document?      @relation(fields: [documentId], references: [id])

  @@index([planId])
  @@index([assigneeId, status])
  @@index([completedById])
  @@index([documentId])
  @@map("onboarding_tasks")
}

// ─────────────────────────────────────────────────────────────────────────────
// Workforce / ERP-lite
// ─────────────────────────────────────────────────────────────────────────────

model Project {
  id          String        @id @default(uuid(7)) @db.Uuid
  clientId    String        @map("client_id") @db.Uuid
  name        String
  code        String?
  location    String?
  emirate     Emirate?
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?     @map("start_date") @db.Date
  endDate     DateTime?     @map("end_date") @db.Date
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?       @map("created_by_id") @db.Uuid

  client    Client @relation(fields: [clientId], references: [id])
  createdBy User?  @relation("ProjectCreatedBy", fields: [createdById], references: [id])

  manpowerRequests ManpowerRequest[]
  deployments      Deployment[]

  @@unique([clientId, name])
  @@index([status])
  @@index([createdById])
  @@map("projects")
}

/// Overlapping active deployments for one employee are rejected by an exclusion constraint
/// (integrity migration), not only by the service.
model Deployment {
  id             String           @id @default(uuid(7)) @db.Uuid
  employeeId     String           @map("employee_id") @db.Uuid
  projectId      String           @map("project_id") @db.Uuid
  /// Copied from the project for scoping (ACCOUNT_MANAGER / CLIENT_USER) without joins.
  clientId       String           @map("client_id") @db.Uuid
  startDate      DateTime         @map("start_date") @db.Date
  endDate        DateTime?        @map("end_date") @db.Date
  billRateFils   Int              @map("bill_rate_fils")
  currency       String           @default("AED") @db.Char(3)
  status         DeploymentStatus @default(PLANNED)
  /// HR Manager override when onboarding is incomplete (US-DEP-01).
  overrideReason String?          @map("override_reason")
  endReason      String?          @map("end_reason")
  version        Int              @default(1)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById    String?          @map("created_by_id") @db.Uuid

  employee  Employee @relation(fields: [employeeId], references: [id])
  project   Project  @relation(fields: [projectId], references: [id])
  client    Client   @relation(fields: [clientId], references: [id])
  createdBy User?    @relation("DeploymentCreatedBy", fields: [createdById], references: [id])

  timesheets   Timesheet[]
  invoiceLines InvoiceLine[]

  @@index([employeeId])
  @@index([projectId])
  @@index([clientId, status])
  @@index([status])
  @@index([createdById])
  @@map("deployments")
}

model Timesheet {
  id            String          @id @default(uuid(7)) @db.Uuid
  deploymentId  String          @map("deployment_id") @db.Uuid
  /// Copied from the deployment for scoping (EMPLOYEE / CLIENT_USER) without joins.
  employeeId    String          @map("employee_id") @db.Uuid
  clientId      String          @map("client_id") @db.Uuid
  /// Monday of the ISO week.
  weekStart     DateTime        @map("week_start") @db.Date
  status        TimesheetStatus @default(DRAFT)
  totalMinutes  Int             @default(0) @map("total_minutes")
  submittedAt   DateTime?       @map("submitted_at") @db.Timestamptz(3)
  decidedAt     DateTime?       @map("decided_at") @db.Timestamptz(3)
  decidedById   String?         @map("decided_by_id") @db.Uuid
  rejectComment String?         @map("reject_comment")
  invoiceId     String?         @map("invoice_id") @db.Uuid
  version       Int             @default(1)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById   String?         @map("created_by_id") @db.Uuid

  deployment Deployment @relation(fields: [deploymentId], references: [id])
  employee   Employee   @relation(fields: [employeeId], references: [id])
  client     Client     @relation(fields: [clientId], references: [id])
  decidedBy  User?      @relation("TimesheetDecidedBy", fields: [decidedById], references: [id])
  invoice    Invoice?   @relation(fields: [invoiceId], references: [id])
  createdBy  User?      @relation("TimesheetCreatedBy", fields: [createdById], references: [id])

  entries TimesheetEntry[]

  @@unique([deploymentId, weekStart])
  @@index([clientId, status])
  @@index([employeeId, weekStart])
  @@index([status])
  @@index([invoiceId])
  @@index([decidedById])
  @@index([createdById])
  @@map("timesheets")
}

model TimesheetEntry {
  id          String   @id @default(uuid(7)) @db.Uuid
  timesheetId String   @map("timesheet_id") @db.Uuid
  date        DateTime @db.Date
  /// 0–960 (16 h), CHECK in the integrity migration.
  minutes     Int
  note        String?

  timesheet Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  @@unique([timesheetId, date])
  @@map("timesheet_entries")
}

/// Totals are computed server-side from approved timesheets; ISSUED invoices are immutable
/// (corrections go through VOID + regenerate).
model Invoice {
  id            String        @id @default(uuid(7)) @db.Uuid
  /// Assigned on issue, e.g. INV-2026-000123 (from invoice_number_sequences).
  number        String?       @unique
  clientId      String        @map("client_id") @db.Uuid
  status        InvoiceStatus @default(DRAFT)
  periodStart   DateTime      @map("period_start") @db.Date
  periodEnd     DateTime      @map("period_end") @db.Date
  issueDate     DateTime?     @map("issue_date") @db.Date
  dueDate       DateTime?     @map("due_date") @db.Date
  currency      String        @default("AED") @db.Char(3)
  subtotalFils  Int           @map("subtotal_fils")
  vatRateBps    Int           @map("vat_rate_bps")
  vatFils       Int           @map("vat_fils")
  totalFils     Int           @map("total_fils")
  paidOn        DateTime?     @map("paid_on") @db.Date
  voidReason    String?       @map("void_reason")
  pdfStorageKey String?       @map("pdf_storage_key")
  version       Int           @default(1)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById   String?       @map("created_by_id") @db.Uuid

  client    Client @relation(fields: [clientId], references: [id])
  createdBy User?  @relation("InvoiceCreatedBy", fields: [createdById], references: [id])

  lines      InvoiceLine[]
  timesheets Timesheet[]

  @@index([clientId, status])
  @@index([status])
  @@index([issueDate])
  @@index([createdById])
  @@index([createdAt])
  @@map("invoices")
}

model InvoiceLine {
  id           String @id @default(uuid(7)) @db.Uuid
  invoiceId    String @map("invoice_id") @db.Uuid
  deploymentId String @map("deployment_id") @db.Uuid
  description  String
  minutes      Int
  rateFils     Int    @map("rate_fils")
  amountFils   Int    @map("amount_fils")
  sortOrder    Int    @default(0) @map("sort_order")

  invoice    Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  deployment Deployment @relation(fields: [deploymentId], references: [id])

  @@index([invoiceId])
  @@index([deploymentId])
  @@map("invoice_lines")
}

/// Gap-free yearly invoice numbering: the row is locked (SELECT … FOR UPDATE) inside the
/// issue transaction.
model InvoiceNumberSequence {
  year      Int @id
  lastValue Int @default(0) @map("last_value")

  @@map("invoice_number_sequences")
}

// ─────────────────────────────────────────────────────────────────────────────
// Workflow engine and automation
// ─────────────────────────────────────────────────────────────────────────────

model WorkflowDefinition {
  id          String          @id @default(uuid(7)) @db.Uuid
  name        String
  subject     WorkflowSubject
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?         @map("created_by_id") @db.Uuid

  createdBy User? @relation("WorkflowCreatedBy", fields: [createdById], references: [id])

  steps            WorkflowStep[]
  approvalRequests ApprovalRequest[]

  @@index([subject, active])
  @@index([createdById])
  @@map("workflow_definitions")
}

model WorkflowStep {
  id           String   @id @default(uuid(7)) @db.Uuid
  workflowId   String   @map("workflow_id") @db.Uuid
  stepOrder    Int      @map("step_order")
  name         String
  approverRole RoleCode @map("approver_role")

  workflow WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, stepOrder])
  @@map("workflow_steps")
}

/// Approval for exactly one subject (CHECK in the integrity migration), via real foreign keys.
model ApprovalRequest {
  id                String          @id @default(uuid(7)) @db.Uuid
  workflowId        String          @map("workflow_id") @db.Uuid
  subject           WorkflowSubject
  manpowerRequestId String?         @map("manpower_request_id") @db.Uuid
  offerId           String?         @map("offer_id") @db.Uuid
  currentStep       Int             @default(1) @map("current_step")
  status            ApprovalStatus  @default(PENDING)
  decidedAt         DateTime?       @map("decided_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById       String?         @map("created_by_id") @db.Uuid

  workflow        WorkflowDefinition @relation(fields: [workflowId], references: [id])
  manpowerRequest ManpowerRequest?   @relation(fields: [manpowerRequestId], references: [id])
  offer           Offer?             @relation(fields: [offerId], references: [id])
  createdBy       User?              @relation("ApprovalRequestCreatedBy", fields: [createdById], references: [id])

  decisions ApprovalDecision[]

  @@index([workflowId])
  @@index([manpowerRequestId])
  @@index([offerId])
  @@index([status])
  @@index([createdById])
  @@map("approval_requests")
}

model ApprovalDecision {
  id                String               @id @default(uuid(7)) @db.Uuid
  approvalRequestId String               @map("approval_request_id") @db.Uuid
  stepOrder         Int                  @map("step_order")
  decision          ApprovalDecisionType
  comment           String?
  decidedById       String               @map("decided_by_id") @db.Uuid
  decidedAt         DateTime             @default(now()) @map("decided_at") @db.Timestamptz(3)

  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  decidedBy       User            @relation(fields: [decidedById], references: [id])

  @@unique([approvalRequestId, stepOrder])
  @@index([decidedById])
  @@map("approval_decisions")
}

/// When [event] If [conditions] Then [actions] — conditions/actions are validated JSON
/// (Zod schemas in packages/shared, docs/api-contract.md §2.18).
model AutomationRule {
  id          String          @id @default(uuid(7)) @db.Uuid
  name        String
  active      Boolean         @default(true)
  event       AutomationEvent
  conditions  Json            @default("[]")
  actions     Json
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?         @map("created_by_id") @db.Uuid
  deletedAt   DateTime?       @map("deleted_at") @db.Timestamptz(3)

  createdBy User? @relation("AutomationRuleCreatedBy", fields: [createdById], references: [id])

  runs AutomationRun[]

  @@index([event, active])
  @@index([createdById])
  @@map("automation_rules")
}

model AutomationRun {
  id         String          @id @default(uuid(7)) @db.Uuid
  ruleId     String          @map("rule_id") @db.Uuid
  event      AutomationEvent
  payload    Json
  status     RunStatus       @default(PENDING)
  result     Json?
  error      String?
  attempts   Int             @default(0)
  startedAt  DateTime?       @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime?       @map("finished_at") @db.Timestamptz(3)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  rule AutomationRule @relation(fields: [ruleId], references: [id])

  @@index([ruleId, createdAt(sort: Desc)])
  @@index([status])
  @@map("automation_runs")
}

/// Generic work item (renewal tasks, data-subject requests, automation "create task").
/// `entityType`/`entityId` is a display link to any record, so it has no foreign key.
model Task {
  id           String     @id @default(uuid(7)) @db.Uuid
  title        String
  description  String?
  status       TaskStatus @default(OPEN)
  assigneeId   String?    @map("assignee_id") @db.Uuid
  assigneeRole RoleCode?  @map("assignee_role")
  dueDate      DateTime?  @map("due_date") @db.Date
  entityType   String?    @map("entity_type")
  entityId     String?    @map("entity_id") @db.Uuid
  completedAt  DateTime?  @map("completed_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById  String?    @map("created_by_id") @db.Uuid

  assignee  User? @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy User? @relation("TaskCreatedBy", fields: [createdById], references: [id])

  @@index([assigneeId, status])
  @@index([assigneeRole, status])
  @@index([entityType, entityId])
  @@index([createdById])
  @@map("tasks")
}

// ─────────────────────────────────────────────────────────────────────────────
// AI
// ─────────────────────────────────────────────────────────────────────────────

/// Every LLM call is logged here (CLAUDE.md §12).
model AiRequest {
  id                    String          @id @default(uuid(7)) @db.Uuid
  feature               AiFeature
  provider              String
  model                 String
  promptVersion         String          @map("prompt_version")
  inputTokens           Int             @default(0) @map("input_tokens")
  outputTokens          Int             @default(0) @map("output_tokens")
  /// Integer micro-dollars (1 USD = 1,000,000) to avoid floats.
  estimatedCostMicroUsd Int             @default(0) @map("estimated_cost_micro_usd")
  latencyMs             Int             @map("latency_ms")
  status                AiRequestStatus
  errorCode             String?         @map("error_code")
  userId                String?         @map("user_id") @db.Uuid
  /// Display link to the record the call was about (no FK: may be any entity).
  entityType            String?         @map("entity_type")
  entityId              String?         @map("entity_id") @db.Uuid
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id])

  results      AiResult[]
  matchResults MatchResult[]

  @@index([feature, createdAt])
  @@index([createdAt])
  @@index([userId])
  @@map("ai_requests")
}

/// Validated output of a feature (CV parse, JD draft, interview kit, summary), shown as an
/// "AI-assisted suggestion" until a human confirms it.
model AiResult {
  id          String    @id @default(uuid(7)) @db.Uuid
  aiRequestId String    @map("ai_request_id") @db.Uuid
  feature     AiFeature
  entityType  String?   @map("entity_type")
  entityId    String?   @map("entity_id") @db.Uuid
  output      Json
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  aiRequest AiRequest @relation(fields: [aiRequestId], references: [id])

  @@index([aiRequestId])
  @@index([entityType, entityId])
  @@map("ai_results")
}

/// Score = deterministic pre-score + bounded LLM adjustment (±10), cached per application
/// and prompt version (US-APP-03).
model MatchResult {
  id            String   @id @default(uuid(7)) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  promptVersion String   @map("prompt_version")
  preScore      Int      @map("pre_score")
  adjustment    Int
  score         Int
  matched       Json
  partial       Json
  missing       Json
  explanation   String?
  aiRequestId   String?  @map("ai_request_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  aiRequest   AiRequest?  @relation(fields: [aiRequestId], references: [id])

  @@unique([applicationId, promptVersion])
  @@index([aiRequestId])
  @@map("match_results")
}

// ─────────────────────────────────────────────────────────────────────────────
// Platform: notifications, audit, webhooks, settings, idempotency, data protection
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  /// Transactional outbox: rows with sendEmail are emailed by a scheduled job after commit.
  sendEmail Boolean   @default(false) @map("send_email")
  emailedAt DateTime? @map("emailed_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([sendEmail, emailedAt])
  @@map("notifications")
}

/// Append-only (enforced by a trigger). Sensitive fields are redacted from before/after by
/// AuditService. `entity`/`entityId` can point at any table, so there is no FK there.
model AuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Null for system jobs and public (careers portal) actions.
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  ip        String?
  userAgent String?  @map("user_agent")
  traceId   String?  @map("trace_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Webhook {
  id          String         @id @default(uuid(7)) @db.Uuid
  url         String
  events      WebhookEvent[]
  /// Per-endpoint signing secret, encrypted by the webhooks module before it is stored.
  secret      String
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?        @map("created_by_id") @db.Uuid
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz(3)

  createdBy User? @relation("WebhookCreatedBy", fields: [createdById], references: [id])

  deliveries WebhookDelivery[]

  @@index([createdById])
  @@map("webhooks")
}

model WebhookDelivery {
  id             String         @id @default(uuid(7)) @db.Uuid
  webhookId      String         @map("webhook_id") @db.Uuid
  event          WebhookEvent
  payload        Json
  status         DeliveryStatus @default(PENDING)
  attempts       Int            @default(0)
  responseStatus Int?           @map("response_status")
  /// Truncated response body for debugging.
  responseBody   String?        @map("response_body")
  nextAttemptAt  DateTime?      @map("next_attempt_at") @db.Timestamptz(3)
  deliveredAt    DateTime?      @map("delivered_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt(sort: Desc)])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

/// Key/value runtime settings (approval threshold, alert days, retention, AI providers, VAT).
model Setting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?  @map("updated_by_id") @db.Uuid

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@index([updatedById])
  @@map("settings")
}

/// Stored responses for `Idempotency-Key` requests (invoice generation), kept 24 h.
model IdempotencyKey {
  scope          String
  key            String
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  @@id([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Candidate export/delete requests from the tracking link (docs/security.md §10).
model DataSubjectRequest {
  id           String            @id @default(uuid(7)) @db.Uuid
  candidateId  String            @map("candidate_id") @db.Uuid
  type         DataRequestType
  status       DataRequestStatus @default(OPEN)
  resolvedById String?           @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime?         @map("resolved_at") @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  candidate  Candidate @relation(fields: [candidateId], references: [id])
  resolvedBy User?     @relation(fields: [resolvedById], references: [id])

  @@index([candidateId])
  @@index([status])
  @@index([resolvedById])
  @@map("data_subject_requests")
}
