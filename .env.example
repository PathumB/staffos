# Copy to .env and fill in. Never commit .env. Every variable used by the app is listed here.

NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173
PORT=3000
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace
SWAGGER_ENABLED=true            # Swagger UI at /api/docs; off in production unless true
DEMO_MODE=false                 # enables POST /admin/demo-reset
VITE_DEMO_MODE=false            # web: show demo-account shortcuts on the login page
LOGIN_RATE_LIMIT_PER_MIN=10     # per IP; keep 10 in production (raised only for E2E)

# Neon direct (non-pooled) connection strings, e.g.
# postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full&channel_binding=require
DATABASE_URL=                   # dev branch
DATABASE_URL_TEST=              # test branch (used by pnpm test; never the dev DB)
DATABASE_URL_READONLY=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

STORAGE_PROVIDER=local          # local | supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=documents

MAIL_PROVIDER=console           # console | ethereal | smtp
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

LLM_DEFAULT_PROVIDER=gemini     # gemini | claude | openai | mock
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MONTHLY_BUDGET_USD=0

WEBHOOK_SIGNING_SECRET=
SENTRY_DSN=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
